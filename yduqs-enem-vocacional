  const textC1 = curso1Selecionado ? curso1Selecionado : 'Selecione uma opção';
  const textC2 = curso2Selecionado ? curso2Selecionado : 'Selecione uma opção';

  content.innerHTML = `
    <div style="font-weight:700; font-size:15px; margin-bottom:8px; color:#111B21;">Seleção de Cursos</div>
    <p style="font-size:13px; color:#667781; margin-bottom:16px; line-height:1.4;">
