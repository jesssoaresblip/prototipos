  { id: 5484, nome: "Ciência Política" },
  { id: 5487, nome: "Ciências Biológicas (Bacharelado)" },
  { id: 7115, nome: "Direito" },
  { id: 7119, nome: "Enfermagem" },
  { id: 7127, nome: "Farmácia" },
  { id: 7145, nome: "Medicina" },
  { id: 7147, nome: "Nutrição" },
  { id: 7151, nome: "Psicologia" }
];

const opcoesDesempate = [
