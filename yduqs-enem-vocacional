<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Protótipo Interativo - Teste Vocacional ENEM</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
<style>
:root {
  --paper: #EDEDEB;
  --panel: #FFFFFF;
  --ink: #0A0A0A;
  --on-ink: #FFFFFF;
  --muted: #6E6E6E;
  --line: #D8D8D6;
  --soft: #F5F5F4;
  --wa-dark: #075E54;
  --wa-teal: #008069;
  --wa-green: #00A884;
  --wa-bg: #EFEAE2;
  --wa-out: #D9FDD3;
  --ui-font: "Instrument Sans", system-ui, sans-serif;
  --wa-font: "Instrument Sans", Roboto, Helvetica, Arial, sans-serif;
  --estacio-blue: #002D62;
}

* { box-sizing: border-box; }
body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--ui-font); font-size: 14px; line-height: 1.45; display: flex; flex-direction: column; min-height: 100vh; }
button, select, input { cursor: pointer; font-family: inherit; }

/* Header Superior */
.topbar { background: var(--estacio-blue); color: #fff; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 24px; min-height: 60px; }
.brand { display: flex; align-items: center; gap: 12px; }
.brand img { height: 32px; width: auto; object-fit: contain; }
.brand span { font-size: 13px; color: #B0C4DE; }

/* Grid principal */
.bench { flex: 1; display: grid; grid-template-columns: 320px minmax(380px, 1fr); gap: 16px; padding: 16px; min-height: 0; }
.panel { background: var(--panel); border: 1px solid var(--line); border-radius: 12px; display: flex; flex-direction: column; overflow: hidden; }
.panel-head { padding: 16px; border-bottom: 1px solid var(--line); background: #FAF9F6; }
.panel-head h2 { margin: 0; font-size: 15px; font-weight: 700; color: var(--estacio-blue); }
.panel-head p { margin: 4px 0 0; color: var(--muted); font-size: 12px; }
.panel-body { overflow-y: auto; padding: 16px; flex: 1; }

.reset-btn { width: 100%; background: var(--panel); color: var(--estacio-blue); border: 1px solid var(--line); padding: 10px; border-radius: 6px; font-weight: 600; font-size: 13px; margin-top: 15px; }
.reset-btn:hover { background: var(--soft); }

/* Celular WhatsApp */
.stage { display: flex; align-items: center; justify-content: center; }
.phone { width: 375px; height: 740px; background: #111B21; border-radius: 36px; padding: 10px; box-shadow: 0 20px 40px rgba(0,0,0,0.3); position: relative; }
.screen { background: var(--wa-bg); border-radius: 28px; height: 100%; overflow: hidden; display: flex; flex-direction: column; font-family: var(--wa-font); position: relative; }
.status { height: 24px; background: var(--wa-dark); color: #fff; display: flex; justify-content: space-between; align-items: center; padding: 0 16px; font-size: 11px; }
.wa-head { background: var(--wa-dark); color: #fff; display: flex; align-items: center; gap: 10px; padding: 8px 12px; }
.wa-head .av { width: 36px; height: 36px; border-radius: 50%; background: #FFFFFF; padding: 2px; display: grid; place-items: center; overflow: hidden; }
.wa-head .av img { width: 100%; height: 100%; object-fit: contain; }
.wa-head .who b { display: block; font-size: 14px; }
.wa-head .who span { font-size: 11px; opacity: 0.8; }

.chat { flex: 1; overflow-y: auto; padding: 10px; background-image: radial-gradient(rgba(7,94,84,0.06) 1px, transparent 1.2px); background-size: 16px 16px; }
.day { margin: 8px auto 6px; background: #fff; color: #54656F; font-size: 11px; padding: 3px 8px; border-radius: 6px; width: max-content; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); }
.row { display: flex; margin: 4px 0; width: 100%; }
.row.in { justify-content: flex-start; }
.row.out { justify-content: flex-end; }

.bub { max-width: 88%; padding: 8px 10px; border-radius: 8px; font-size: 12.5px; line-height: 1.38; color: #111B21; background: #fff; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); position: relative; word-wrap: break-word; }
.bub-img { width: 100%; border-radius: 6px; margin-bottom: 6px; object-fit: cover; max-height: 180px; display: block; }
.bub-footer { font-size: 10.5px; color: #667781; border-top: 1px solid #E9EDEF; margin-top: 6px; padding-top: 4px; font-style: italic; }
.out .bub { background: var(--wa-out); }
.meta { float: right; margin: 4px 0 -2px 8px; font-size: 10px; color: #667781; }

.msg-group { width: 88%; margin: 4px 0; }
.msg-group .bub { max-width: 100%; }
.quick-reply-btn { border: 0; background: #fff; color: var(--wa-teal); font-weight: 600; font-size: 13px; padding: 9px; border-radius: 8px; text-align: center; width: 100%; margin-top: 4px; box-shadow: 0 1px 0.5px rgba(0,0,0,0.13); display: block; }
.quick-reply-btn:hover { background: #F0FDF4; }

/* Simulação Modal WhatsApp Flows Fiel aos Screenshots */
.flows-modal { display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #FFF; z-index: 50; border-radius: 28px; flex-direction: column; overflow: hidden; animation: slideUp 0.25s ease-out; }
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

/* Header do WhatsApp Flows */
.flows-head { background: #FFFFFF; padding: 12px 16px 8px; display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid #F0F0F0; }
.flows-head-top { display: flex; justify-content: space-between; align-items: center; }
.flows-head-title-wrap { display: flex; align-items: center; gap: 12px; }
.flows-back-btn { background: none; border: none; font-size: 16px; color: #111B21; cursor: pointer; padding: 0; display: flex; align-items: center; }
.flows-head-title { font-size: 16px; font-weight: 600; color: #111B21; }
.flows-head-more { background: none; border: none; font-size: 16px; color: #111B21; cursor: pointer; }

/* Barra de progresso verde */
.flows-progress-bar { width: 100%; height: 3px; background: #E9EDEF; border-radius: 2px; overflow: hidden; margin-top: 4px; }
.flows-progress-fill { height: 100%; background: #00A884; transition: width 0.3s ease; }

.flows-body { flex: 1; padding: 16px; overflow-y: auto; font-size: 13px; color: #111B21; }

/* Estilização nativa dos componentes do WhatsApp Flows */
.flows-q-block { margin-bottom: 24px; }
.flows-q-title { font-weight: 600; font-size: 14px; color: #111B21; margin-bottom: 12px; line-height: 1.4; }
.flows-radio-group { display: flex; flex-direction: column; gap: 10px; }
.flows-radio-opt { display: flex; align-items: center; justify-content: space-between; padding: 6px 0; cursor: pointer; }
.flows-radio-opt span { font-size: 14px; color: #111B21; }
.flows-radio-circle { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #8696A0; display: flex; align-items: center; justify-content: center; }
.flows-radio-opt.selected .flows-radio-circle { border-color: #00A884; }
.flows-radio-opt.selected .flows-radio-circle::after { content: ""; width: 10px; height: 10px; border-radius: 50%; background: #00A884; }

.flows-dropdown-trigger { width: 100%; border: 1px solid #8696A0; border-radius: 8px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; background: #FFF; font-size: 14px; color: #111B21; margin-top: 12px; }

.flows-foot { padding: 12px 16px 8px; background: #FFF; border-top: 1px solid #F0F0F0; display: flex; flex-direction: column; align-items: center; }
.flows-submit-btn { width: 100%; background: #E9EDEF; color: #8696A0; border: none; padding: 12px; border-radius: 20px; font-weight: 600; font-size: 14px; text-align: center; }
.flows-submit-btn.active { background: #00A884; color: #FFFFFF; }
.flows-admin-footer { font-size: 11px; color: #667781; margin-top: 8px; display: flex; align-items: center; gap: 4px; }
.flows-admin-footer a { color: #008069; text-decoration: none; }

/* Sub-tela do WhatsApp Flows */
.subscreen-picker { display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #FFF; z-index: 60; flex-direction: column; animation: slideRight 0.2s ease-out; }
@keyframes slideRight { from { transform: translateX(100%); } to { transform: translateX(0); } }
.subscreen-head { background: #FFF; color: #111B21; padding: 14px 16px; display: flex; align-items: center; gap: 16px; border-bottom: 1px solid #E9EDEF; }
.subscreen-back { background: none; border: none; color: #111B21; font-size: 18px; cursor: pointer; }
.subscreen-title { font-size: 16px; font-weight: 600; }
.subscreen-body { flex: 1; overflow-y: auto; padding: 8px 0; }
.picker-item { padding: 14px 16px; border-bottom: 1px solid #F1F5F9; font-size: 13.5px; color: #111B21; cursor: pointer; line-height: 1.35; }
.picker-item:hover { background: #F8FAFC; }
.picker-item.selected { background: #E6F4F1; color: var(--wa-teal); font-weight: 600; }

/* Regras de Negócio inline */
.btn-rule-trigger { margin: 6px 0 2px; background: #E1F2FB; color: #1B4F72; border: 1px dashed #027EB5; border-radius: 6px; padding: 6px 10px; font-size: 11px; font-weight: 600; text-align: left; width: 100%; display: flex; justify-content: space-between; }
.rule-box { margin: 4px 0 8px; background: #FFF3C4; color: #54656F; font-size: 11px; padding: 8px 10px; border-radius: 6px; border-left: 3px solid #FFC107; box-shadow: 0 1px 0.5px rgba(0,0,0,0.1); width: 100%; line-height: 1.4; display: block; }
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRSych2Qg0t5um9kmCzxzeOH4g2kGnaU9lJHxEwc9oWI6Gg3niZU4xgSw0&s=10" alt="Logo">
    <span>Protótipo Interativo &amp; Documentação de Regras — Teste Vocacional ENEM</span>
  </div>
</header>

<div class="bench">
  
  <!-- Painel de Instruções -->
  <aside class="panel">
    <div class="panel-head">
      <h2>Instruções do Simulador</h2>
      <p>Navegação interativa da jornada:</p>
    </div>
    <div class="panel-body">
      <div style="padding: 12px; background: #EBF8FF; border: 1px solid #BEE3F8; border-radius: 8px; font-size: 12px; line-height: 1.4; color: #2B6CB0;">
        <b>💡 Como Utilizar:</b>
        <p style="margin: 6px 0 0;">Utilize a tela do WhatsApp ao lado para interagir diretamente com a jornada. O Teste Vocacional no WhatsApp Flows foi atualizado com a experiência exata dos screenshots (Abertura + 3 Perguntas por Tela + Seleção de Palavras + Conclusão).</p>
      </div>

      <button class="reset-btn" onclick="reiniciarJornada()">🔄 Reiniciar Conversa</button>
    </div>
  </aside>

  <!-- Visão WhatsApp -->
  <main class="stage">
    <div class="phone">
      <div class="screen">
        <div class="status"><span>16:43</span><span>5G ▮▮▮</span></div>
        <header class="wa-head">
          <div class="av">
            <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRSych2Qg0t5um9kmCzxzeOH4g2kGnaU9lJHxEwc9oWI6Gg3niZU4xgSw0&s=10" alt="Avatar Logo">
          </div>
          <div class="who"><b>Celula Tokyo</b><span>Conta Comercial Oficial</span></div>
        </header>
        <div class="chat" id="chat">
          <!-- Conteúdo inicial injetado via JS -->
        </div>

        <!-- Modal WhatsApp Flows -->
        <div class="flows-modal" id="flowsModal" style="display: none;">
          <div class="flows-head">
            <div class="flows-head-top">
              <div class="flows-head-title-wrap">
                <button class="flows-back-btn" id="flowsBackBtn" onclick="voltarPaginaFlows()">←</button>
                <span class="flows-head-title" id="flowsTitleHeader">Teste Vocacional</span>
              </div>
              <button class="flows-head-more">⋮</button>
            </div>
            <div class="flows-progress-bar" id="flowsProgressWrap">
              <div class="flows-progress-fill" id="flowsProgressFill" style="width: 20%;"></div>
            </div>
          </div>

          <div class="flows-body" id="flowsContent"></div>

          <div class="flows-foot">
            <button class="flows-submit-btn active" id="flowsSubmitBtn" onclick="avancarFlows()">Começar</button>
            <div class="flows-admin-footer">
              <span style="font-size:10px;">🌐</span> Administrado por Celula Tokyo. <a href="#">Más información</a>
            </div>
          </div>

          <!-- Sub-tela de Lista Suspensa (Dropdown) -->
          <div class="subscreen-picker" id="subscreenPicker">
            <div class="subscreen-head">
              <button class="subscreen-back" onclick="fecharSubscreenPicker()">←</button>
              <span class="subscreen-title" id="subscreenTitle">Selecione uma opção</span>
            </div>
            <div class="subscreen-body" id="subscreenList"></div>
          </div>
        </div>

      </div>
    </div>
  </main>

</div>

<script>
let estadoPasso = 0;
let paginaFlows = 0;
let modoFlows = 'cadastro';
let respostasFlows = {};
let respostaDesempate = '';
let curso1Selecionado = '';
let curso2Selecionado = '';

let dadosUsuario = {
  nome: 'Ana',
  email: 'ana.estudante@email.com',
  nascimento: '15/08/2005',
  telefone: '(11) 98765-4321'
};

const urlImagemTemplate = 'https://blipmediastore.blob.core.windows.net/public-medias/Media_79598f37-5880-4a0c-ba58-a10a9dafb8be';

