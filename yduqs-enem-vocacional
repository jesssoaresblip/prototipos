    `;
  } else if (paginaFlows >= 1 && paginaFlows <= 9) {
    titleHeader.innerText = `Questionário [${paginaFlows} de 11]`;
    backBtn.style.display = "flex";
    submitBtn.innerText = "Continuar";
    submitBtn.className = "flows-submit-btn active";

    const idxInicio = (paginaFlows - 1) * 3;
    const p1 = bancoPerguntasVocacional[idxInicio];
    const p2 = bancoPerguntasVocacional[idxInicio + 1];
    const p3 = bancoPerguntasVocacional[idxInicio + 2];

    content.innerHTML = `
      <!-- Pergunta 1 -->
