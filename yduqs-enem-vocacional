const bancoPerguntasVocacional = [
  "Organizar documentos, planejar tarefas e criar processos.",
  "Iniciar novas atividades, definir escopo de trabalho e estabelecer metas.",
  "Criar ilustrações, peças gráficas ou materiais visuais.",
  "Aprender novos idiomas e estudar a cultura de outros países.",
  "Auxiliar pessoas em situações difíceis ou de vulnerabilidade.",
  "Analisar estatísticas e interpretar gráficos ou relatórios de desempenho.",
  "Gerenciar equipes e delegar funções operacionais.",
  "Escrever artigos, textos publicitários ou obras literárias.",
  "Desenvolver códigos, softwares ou aplicações web.",
  "Montar, reparar ou dar manutenção em aparelhos eletrônicos.",
  "Acompanhar tendências do mercado financeiro e investimentos.",
  "Organizar eventos, reuniões e recepções de convidados.",
  "Realizar pesquisas científicas e experimentos em laboratório.",
  "Cuidar da saúde, prevenção de doenças e bem-estar físico de pessoas.",
  "Elaborar estratégias de marketing e campanhas em redes sociais.",
  "Mediar conflitos e negociar acordos entre diferentes partes.",
  "Desenhar móveis, ambientes ou estruturas arquitetônicas.",
  "Trabalhar ao ar livre com meio ambiente, plantas ou animais.",
  "Avaliar custos, orçamentos e fazer planejamento financeiro.",
  "Ensinar, dar aulas ou treinar pessoas em determinada área.",
  "Compor músicas, atuar em peças de teatro ou performances.",
  "Analisar leis, contratos e regulamentações jurídicas.",
  "Inspecionar a qualidade de produtos, serviços ou processos.",
  "Atender clientes e prestar suporte técnico ou comercial.",
  "Planejar rotas de logística e cadeia de suprimentos.",
  "Criar estratégias de sustentabilidade e responsabilidade social.",
  "Liderar negociações de vendas e expansão de negócios."
];

function reiniciarJornada() {
  estadoPasso = 0;
  paginaFlows = 0;
  modoFlows = 'cadastro';
  respostasFlows = {};
  respostaDesempate = '';
  curso1Selecionado = '';
  curso2Selecionado = '';
  
  const chat = document.getElementById('chat');
  chat.innerHTML = `
    <div class="day">HOJE</div>
    
    <div class="msg-group">
      <div class="row in">
        <div class="bub">
          <img src="${urlImagemTemplate}" class="bub-img" alt="Imagem Enem Estácio">
          O Enem está chegando! <b>Já pensou em qual carreira seguir</b>? 🎓<br><br>
          Dê o play no seu futuro com a Estácio! Faça o teste vocacional e descubra quais cursos combinam com seu perfil!
          <div class="bub-footer">Para parar de receber mensagens, responda com Cancelar.</div>
          <span class="meta">16:43</span>
        </div>
      </div>
      <button class="quick-reply-btn" onclick="clicarFazerTeste()">Fazer teste</button>
      <button class="quick-reply-btn" onclick="clicarAgoraNao()">Agora não</button>
    </div>
    <div id="anchorEtapa1"></div>
  `;
}

function clicarAgoraNao() {
  const anchor = document.getElementById('anchorEtapa1');
  anchor.innerHTML = `
    <div class="row out">
      <div class="bub">Agora não<span class="meta">16:43</span></div>
    </div>
    <div class="row in">
      <div class="bub">
        Sem problemas! Se mudar de ideia, estarei por aqui para te ajudar a encontrar o curso ideal. Bons estudos para o ENEM! 🚀
        <span class="meta">16:43</span>
      </div>
    </div>
  `;
}

function clicarFazerTeste() {
  const anchor = document.getElementById('anchorEtapa1');
  anchor.innerHTML = `
    <div class="row out">
      <div class="bub">Fazer teste<span class="meta">16:43</span></div>
    </div>
    <div class="row in">
      <div class="bub">
        Antes de começarmos, preciso de alguns dados para gerar o seu perfil e enviar o relatório personalizado para você. 📝
        <span class="meta">16:43</span>
      </div>
    </div>
    <div class="msg-group">
      <button class="quick-reply-btn" onclick="abrirFlowsCadastro()">Preencher cadastro</button>
    </div>
    <div id="anchorCadastro"></div>
  `;
}

function abrirFlowsCadastro() {
  modoFlows = 'cadastro';
  document.getElementById('flowsModal').style.display = 'flex';
  document.getElementById('flowsTitleHeader').innerText = 'Cadastro Inicial Estácio';
  document.getElementById('flowsProgressWrap').style.display = 'none';
  document.getElementById('flowsBackBtn').style.display = 'none';
  renderizarFlowsCadastro();
}

function renderizarFlowsCadastro() {
  const content = document.getElementById('flowsContent');
  const submitBtn = document.getElementById('flowsSubmitBtn');
  
  submitBtn.innerText = "Continuar";
  submitBtn.className = "flows-submit-btn active";

  content.innerHTML = `
    <div style="font-weight:700; font-size:15px; margin-bottom:8px; color:#111B21;">Seus Dados Pessoais</div>
    <p style="font-size:13px; color:#667781; margin-bottom:16px; line-height:1.4;">
      Preencha os campos abaixo para que possamos enviar os seus resultados:
    </p>

    <div style="display:flex; flex-direction:column; gap:12px;">
      <div>
        <label style="font-size:12px; font-weight:600; color:#111B21; display:block; margin-bottom:4px;">Primeiro nome</label>
        <input type="text" style="width:100%; padding:10px 12px; border:1px solid #8696A0; border-radius:8px; font-size:13px;" value="${dadosUsuario.nome}" onchange="dadosUsuario.nome = this.value">
      </div>
      <div>
        <label style="font-size:12px; font-weight:600; color:#111B21; display:block; margin-bottom:4px;">E-mail</label>
        <input type="email" style="width:100%; padding:10px 12px; border:1px solid #8696A0; border-radius:8px; font-size:13px;" value="${dadosUsuario.email}" onchange="dadosUsuario.email = this.value">
      </div>
      <div>
        <label style="font-size:12px; font-weight:600; color:#111B21; display:block; margin-bottom:4px;">Data de nascimento</label>
        <input type="text" style="width:100%; padding:10px 12px; border:1px solid #8696A0; border-radius:8px; font-size:13px;" value="${dadosUsuario.nascimento}" onchange="dadosUsuario.nascimento = this.value">
      </div>
      <div>
        <label style="font-size:12px; font-weight:600; color:#111B21; display:block; margin-bottom:4px;">Telefone para contato</label>
        <input type="tel" style="width:100%; padding:10px 12px; border:1px solid #8696A0; border-radius:8px; font-size:13px;" value="${dadosUsuario.telefone}" onchange="dadosUsuario.telefone = this.value">
      </div>
    </div>
  `;
}

function abrirFlowsVocacional() {
  modoFlows = 'vocacional';
  paginaFlows = 0;
  document.getElementById('flowsModal').style.display = 'flex';
  document.getElementById('flowsProgressWrap').style.display = 'block';
  renderizarFlowsVocacional();
}

function renderizarFlowsVocacional() {
  const content = document.getElementById('flowsContent');
  const submitBtn = document.getElementById('flowsSubmitBtn');
  const titleHeader = document.getElementById('flowsTitleHeader');
  const backBtn = document.getElementById('flowsBackBtn');
  const progressFill = document.getElementById('flowsProgressFill');

  const percProgresso = ((paginaFlows) / 11) * 100;
  progressFill.style.width = (paginaFlows === 0 ? '25%' : (paginaFlows === 11 ? '100%' : `${percProgresso}%`));

  if (paginaFlows === 0) {
    titleHeader.innerText = "Teste Vocacional";
    backBtn.style.display = "none";
    submitBtn.innerText = "Começar";
    submitBtn.className = "flows-submit-btn active";

    content.innerHTML = `
      <div style="font-weight: 700; font-size: 20px; color: #111B21; margin-bottom: 16px;">Orientações</div>
      <ul style="padding-left: 18px; margin: 0 0 20px 0; display: flex; flex-direction: column; gap: 14px; font-size: 14px; color: #111B21; line-height: 1.45;">
        <li>Apresentaremos 30 cenas para <b>você se imaginar realizando cada tarefa</b>.</li>
        <li>Indique o seu interesse escolhendo entre <b>Nada a ver</b> (Nada interessante para mim) e <b>Muito a ver</b> (Muito interessante para mim).</li>
        <li>As respostas enviadas não poderão ser alteradas posteriormente.</li>
      </ul>
