}

function verCursosRelacionados() {
  modoFlows = 'cursos';
  document.getElementById('flowsModal').style.display = 'flex';
  document.getElementById('flowsTitleHeader').innerText = 'Cursos de Interesse';
  document.getElementById('flowsProgressWrap').style.display = 'none';
  document.getElementById('flowsBackBtn').style.display = 'none';
  renderizarFlowsCursos();
}

function renderizarFlowsCursos() {
  const content = document.getElementById('flowsContent');
  const submitBtn = document.getElementById('flowsSubmitBtn');
  
  submitBtn.innerText = 'Continuar';
