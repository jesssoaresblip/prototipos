            <div class="flows-radio-circle"></div>
          </div>
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 1] === 3 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 1}, 3)">
            <span>Neutro</span>
            <div class="flows-radio-circle"></div>
          </div>
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 1] === 5 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 1}, 5)">
            <span>Muito a ver</span>
            <div class="flows-radio-circle"></div>
          </div>
        </div>
      </div>
      <hr style="border: none; border-top: 1px solid #F0F0F0; margin: 16px 0;">

      <!-- Pergunta 2 -->
      <div class="flows-q-block">
        <div class="flows-q-title">${p2}</div>
        <div class="flows-radio-group">
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 2] === 1 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 2}, 1)">
            <span>Nada a ver</span>
            <div class="flows-radio-circle"></div>
          </div>
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 2] === 3 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 2}, 3)">
            <span>Neutro</span>
            <div class="flows-radio-circle"></div>
          </div>
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 2] === 5 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 2}, 5)">
            <span>Muito a ver</span>
            <div class="flows-radio-circle"></div>
          </div>
        </div>
      </div>
      <hr style="border: none; border-top: 1px solid #F0F0F0; margin: 16px 0;">

      <!-- Pergunta 3 -->
      <div class="flows-q-block">
        <div class="flows-q-title">${p3}</div>
        <div class="flows-radio-group">
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 3] === 1 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 3}, 1)">
            <span>Nada a ver</span>
            <div class="flows-radio-circle"></div>
          </div>
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 3] === 3 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 3}, 3)">
            <span>Neutro</span>
            <div class="flows-radio-circle"></div>
          </div>
          <div class="flows-radio-opt ${respostasFlows[idxInicio + 3] === 5 ? 'selected' : ''}" onclick="selecionarOpcao(${idxInicio + 3}, 5)">
            <span>Muito a ver</span>
            <div class="flows-radio-circle"></div>
          </div>
        </div>
      </div>
    `;
  } else if (paginaFlows === 10) {
    titleHeader.innerText = "Questionário [11 de 11]";
    backBtn.style.display = "flex";
    submitBtn.innerText = "Continuar";
    submitBtn.className = "flows-submit-btn active";

    const textoDropdown = respostaDesempate ? respostaDesempate : "Selecione uma opção";

    content.innerHTML = `
      <div style="font-size: 15px; color: #111B21; margin-bottom: 20px; line-height: 1.4;">
        Quais dessas palavras melhor te representam?
      </div>

      <div class="flows-dropdown-trigger" onclick="abrirSubscreenPicker('desempate')">
        <span style="color: ${respostaDesempate ? '#111B21' : '#667781'}">${textoDropdown}</span>
        <span style="font-size: 10px; color: #667781;">▶</span>
      </div>
    `;
  } else if (paginaFlows === 11) {
    titleHeader.innerText = "Concluído";
    backBtn.style.display = "flex";
    submitBtn.innerText = "Concluir";
    submitBtn.className = "flows-submit-btn active";

    content.innerHTML = `
      <div style="font-size: 14px; color: #111B21; margin-bottom: 16px; line-height: 1.4;">
        O seu teste vocacional foi concluído com sucesso. ✅
      </div>
      <div style="font-size: 14px; color: #111B21; line-height: 1.4;">
        Agora é só clicar em <b>Concluir</b> para processarmos os seus resultados. 💙
      </div>
    `;
  }
}

function selecionarOpcao(qNum, valor) {
  respostasFlows[qNum] = valor;
  renderizarFlowsVocacional();
}

function voltarPaginaFlows() {
  if (paginaFlows > 0) {
    paginaFlows--;
    renderizarFlowsVocacional();
  }
}

function abrirSubscreenPicker(tipo) {
  const picker = document.getElementById('subscreenPicker');
  const title = document.getElementById('subscreenTitle');
  const list = document.getElementById('subscreenList');
  
  picker.style.display = 'flex';
  
  if (tipo === 'desempate') {
    title.innerText = "Selecione uma opção";
    let html = '';
    opcoesDesempate.forEach((op) => {
      const isSel = respostaDesempate === op ? 'selected' : '';
      html += `
        <div class="picker-item ${isSel}" onclick="selecionarItemPicker('desempate', '${op.replace(/'/g, "\\'")}')">
          ${op}
        </div>
      `;
    });
    list.innerHTML = html;
  } else if (tipo === 'curso1' || tipo === 'curso2') {
    title.innerText = "Selecione um curso";
    let html = '';
    listaCursosEstacio.forEach((curso) => {
      const valAtual = tipo === 'curso1' ? curso1Selecionado : curso2Selecionado;
      const isSel = valAtual === curso.nome ? 'selected' : '';
      html += `
        <div class="picker-item ${isSel}" onclick="selecionarItemPicker('${tipo}', '${curso.nome.replace(/'/g, "\\'")}')">
          <span>${curso.nome}</span>
        </div>
      `;
    });
    list.innerHTML = html;
  }
}

function fecharSubscreenPicker() {
  document.getElementById('subscreenPicker').style.display = 'none';
}

function selecionarItemPicker(tipo, val) {
  if (tipo === 'desempate') {
    respostaDesempate = val;
    fecharSubscreenPicker();
    renderizarFlowsVocacional();
  } else if (tipo === 'curso1') {
    curso1Selecionado = val;
    fecharSubscreenPicker();
    renderizarFlowsCursos();
  } else if (tipo === 'curso2') {
    curso2Selecionado = val;
    fecharSubscreenPicker();
    renderizarFlowsCursos();
  }
}

function fecharFlows() {
  document.getElementById('flowsModal').style.display = 'none';
}

function avancarFlows() {
  if (modoFlows === 'cadastro') {
    fecharFlows();
    concluirCadastroEIniciarTeste();
  } else if (modoFlows === 'vocacional') {
    if (paginaFlows < 11) {
      paginaFlows++;
      renderizarFlowsVocacional();
    } else {
      fecharFlows();
      exibirResultadoVocacional();
    }
  } else if (modoFlows === 'cursos') {
    fecharFlows();
    salvarCursosEEnviarEmail();
  }
}

function concluirCadastroEIniciarTeste() {
  const anchorCad = document.getElementById('anchorCadastro');
  anchorCad.innerHTML = `
    <div class="row out">
      <div class="bub"><i>[Formulário de Cadastro Enviado]</i><span class="meta">16:43</span></div>
    </div>
    
    <div class="msg-group">
      <div class="row in">
        <div class="bub">
          Cadastro realizado com sucesso, <b>${dadosUsuario.nome}</b>! 🎉<br><br>
          Agora vamos lá! Clique no botão abaixo para iniciar o formulário do seu teste vocacional.
          <span class="meta">16:43</span>
        </div>
      </div>
      <button class="quick-reply-btn" onclick="abrirFlowsVocacional()">Começar teste</button>
    </div>
    <div id="anchorFlows"></div>
  `;
}

